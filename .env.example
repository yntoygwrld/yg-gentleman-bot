# YG Gentleman Bot Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# OPTIONAL: Trigger Settings
# Probability of responding (0.0 to 1.0, default 0.30 = 30%)
TRIGGER_RATE=0.30

# OPTIONAL: Cooldown Settings (in seconds)
# User cooldown - how long before same user can be corrected again (default: 600 = 10 min)
USER_COOLDOWN=600

# Phrase cooldown - how long before same phrase is corrected again in group (default: 1800 = 30 min)
PHRASE_COOLDOWN=1800

# Max corrections per minute in a group (default: 3)
GROUP_RATE_LIMIT=3

# OPTIONAL: Feature Toggles
ENABLE_SPECIAL_RESPONSES=true
ENABLE_LOGGING=true
ENABLE_STATS=true

# OPTIONAL: Admin User IDs (comma-separated)
# These users can use admin commands in any group
ADMIN_IDS=

# OPTIONAL: Bot Info
BOT_NAME=YG Gentleman Bot
BOT_USERNAME=
